# ==============================================================================
# SGEA Training Platform - Variables de Entorno
# ==============================================================================

# Firebase Client Configuration (Configuración pública de la app Web en Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sgea-training.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sgea-training
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sgea-training.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase Admin SDK (Para Server Actions y API Routes)
# Opción A: JSON completo en base64 o string
FIREBASE_SERVICE_ACCOUNT_KEY=""
# Opción B: Variables individuales de la Service Account de Firebase/GCP
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@sgea-training.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Módulo Criptográfico (Llave maestra AES-256 de 32 bytes en hexadecimal o base64)
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Superadministrador Maestro de la Plataforma
SUPERADMIN_EMAIL=gerkof@gmail.com

# URL Base de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# GMC FinSec Billing Engine (Openpay Colombia / BBVA)
# ==============================================================================
# Llave pública de Openpay (se expone al navegador para tokenizar tarjetas de forma segura con Openpay.js)
NEXT_PUBLIC_OPENPAY_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_OPENPAY_MERCHANT_ID=mxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_OPENPAY_SANDBOX_MODE=true

# Credenciales privadas de Servidor (NUNCA exponer al cliente)
OPENPAY_PRIVATE_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENPAY_MERCHANT_ID=mxxxxxxxxxxxxxxxxxxx
OPENPAY_SANDBOX_MODE=true

# Autenticación Básica HTTP para Webhook entrante de Openpay
OPENPAY_WEBHOOK_USER=gmc_openpay_webhook_user
OPENPAY_WEBHOOK_PASSWORD=gmc_super_secure_webhook_secret_password_here
